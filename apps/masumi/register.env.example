# Masumi agent registry (/register) — sokosumi-landing masumi app
#
# Copy into apps/masumi/.env.local for local dev.

# masumi-saas origin (public register API)
NEXT_PUBLIC_SAAS_URL=http://localhost:2999

# Registry network sent to SaaS on complete: Mainnet | Preprod
# Railway/production: MASUMI_REGISTRY_NETWORK is preferred (no NEXT_PUBLIC_ prefix).
# Local/browser: NEXT_PUBLIC_MASUMI_REGISTRY_NETWORK also works.
MASUMI_REGISTRY_NETWORK=Preprod
# NEXT_PUBLIC_MASUMI_REGISTRY_NETWORK=Preprod

# Optional support link on register success errors
# NEXT_PUBLIC_SUPPORT_URL=https://masumi.network/contact
