# Masumi Learn persistence. Production must use a persistent volume or replace the adapter.
MASUMI_LEARN_DB_PATH=./data/masumi-learn.db
MASUMI_LEARN_SESSION_DAYS=7
# Absolute lifetime even while active; capped at 30 days.
MASUMI_LEARN_SESSION_ABSOLUTE_DAYS=30
# Server-to-server OAuth, verifier, and issuer timeout; clamped to 1–30 seconds.
MASUMI_LEARN_OUTBOUND_TIMEOUT_MS=10000

# Sokosumi OAuth 2.0 Authorization Code + PKCE. Store real values as deployment secrets.
SOKOSUMI_OAUTH_CLIENT_ID=
SOKOSUMI_OAUTH_CLIENT_SECRET=
SOKOSUMI_OAUTH_AUTHORIZE_URL=https://api.sokosumi.com/auth/oauth2/authorize
SOKOSUMI_OAUTH_TOKEN_URL=https://api.sokosumi.com/auth/oauth2/token
SOKOSUMI_OAUTH_USERINFO_URL=https://api.sokosumi.com/auth/oauth2/userinfo
SOKOSUMI_OAUTH_REDIRECT_URI=http://localhost:3001/api/learn/auth/callback
SOKOSUMI_OAUTH_SCOPES=openid
SOKOSUMI_OAUTH_END_SESSION_URL=https://api.sokosumi.com/auth/oauth2/end-session
SOKOSUMI_OAUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/learn

# Optional Cardano minting service. The status URL must contain the {id} placeholder.
MASUMI_LEARN_MINT_URL=
MASUMI_LEARN_MINT_STATUS_URL=
MASUMI_LEARN_MINT_TOKEN=
# Optional but recommended: reject an issuer response from any other network.
MASUMI_LEARN_MINT_NETWORK=preprod

# Optional automated Preprod Builder proof verifier. It receives only transaction hash,
# registered service identifier, and course version. Manual review remains available.
MASUMI_LEARN_BUILDER_VERIFY_URL=
MASUMI_LEARN_BUILDER_VERIFY_TOKEN=

# Separate high-privilege token for the proof-review queue and approve/reject action.
MASUMI_LEARN_REVIEW_TOKEN=

# Separate high-privilege token for credential revocation, session invalidation,
# and authenticated readiness diagnostics. Do not reuse another Learn token.
MASUMI_LEARN_ADMIN_TOKEN=

# Local development only. This has no effect in production.
MASUMI_LEARN_DEV_AUTH=false

# Optional aggregate funnel report. Use a long random deployment secret.
MASUMI_LEARN_REPORT_TOKEN=
MASUMI_LEARN_REPORT_MIN_COHORT=5
