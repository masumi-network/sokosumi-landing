{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,catalog-seed.json,assets/**,data/**}",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
