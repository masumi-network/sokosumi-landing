# Monorepo-aware build for the masumi app.
# Railpack 0.27 / Nixpacks fail to copy the npm workspace (packages/shared)
# before install; a Dockerfile gives us a full `COPY . .` so workspace
# resolution works the same as it does locally.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ libatomic1 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY . .
RUN echo "=== /app contents ===" && ls -la \
  && echo "=== packages/ ===" && ls -la packages 2>&1 \
  && echo "=== lockfile ===" && ls -la package-lock.json 2>&1
RUN npm install
RUN npm run build:masumi
ENV NODE_ENV=production
CMD ["node", "apps/masumi/scripts/start-with-sync.mjs"]
